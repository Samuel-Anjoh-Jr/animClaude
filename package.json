{
  "name": "animclaude",
  "version": "1.0.0",
  "private": true,
  "description": "3D animated videos with Three.js + Remotion",
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render src/index.ts Main out/video.mp4",
    "render:still": "remotion still src/index.ts Main out/thumbnail.png --frame=60",
    "captions": "node scripts/transcribe.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@remotion/captions": "4.0.542",
    "@remotion/cli": "4.0.542",
    "@remotion/google-fonts": "4.0.542",
    "@remotion/install-whisper-cpp": "4.0.542",
    "@remotion/media": "4.0.542",
    "@remotion/media-utils": "4.0.542",
    "@remotion/three": "4.0.542",
    "@remotion/transitions": "4.0.542",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.542",
    "three": "^0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "typescript": "^5.9.3"
  }
}
